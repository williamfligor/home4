# Ghostty: Solarized Light, JetBrains Mono, super-key pane motions.

theme = iTerm2 Solarized Light

font-family = JetBrains Mono
font-size = 11

# Let ghostty handle shell integration (and therefore ssh TERM handling).
shell-integration-features = true

# Slot 7 (used by Vim for the current line) reads too dark against this theme.
palette = 7=#eee8d5

# Pane motions, matching the window motions used in Neovim.
keybind = super+h=goto_split:left
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right
keybind = super+backslash=new_split:right
keybind = super+shift+backslash=new_split:down
